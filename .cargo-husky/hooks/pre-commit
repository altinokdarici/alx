#!/usr/bin/env bash
# Installed into .git/hooks by cargo-husky on the first `cargo test` or `cargo clippy`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: cargo fmt --check"
cargo fmt --all -- --check

echo "pre-commit: cargo clippy"
cargo clippy --all-targets -- -D warnings
